# ============================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values
# NEVER commit the actual .env file
# ============================================

# Port the server listens on
PORT=5000

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/todo-mern

# JWT secrets — use long random strings in production (openssl rand -hex 64)
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Token expiry — access token short-lived, refresh token long-lived
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

# Bcrypt salt rounds — 12 is the recommended production minimum
BCRYPT_SALT_ROUNDS=12

# SMTP settings for Nodemailer (use Mailtrap for development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
SMTP_FROM=no-reply@todoapp.com

# Frontend URL — used to build password reset links in emails
CLIENT_URL=http://localhost:5173

# Allowed CORS origin — must match your frontend URL exactly
CLIENT_ORIGIN=http://localhost:5173
