# ============================================
# SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in values.
# NEVER commit the actual .env file.
# ============================================

# Port the server listens on
PORT=5000

# Node environment — set to 'production' on live servers
NODE_ENV=development

# MongoDB connection string
# Example: mongodb+srv://user:pass@cluster.mongodb.net/todo-mern
MONGO_URI=

# JWT secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiry durations
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Bcrypt salt rounds — 12 is the recommended production minimum (prompt requires >=10)
BCRYPT_SALT_ROUNDS=12

# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key exactly as given, including -----BEGIN PRIVATE KEY-----
FIREBASE_PRIVATE_KEY=

# Allowed CORS origin — must match your frontend URL exactly
CORS_ORIGIN=http://localhost:5173

# SMTP settings for Nodemailer (wire up when email provider is decided)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
